# Ingram Micro API Credentials
# Set these in Vercel Dashboard → Settings → Environment Variables
# Or in a local .env file for development

INGRAM_CLIENT_ID=your_client_id_here
INGRAM_CLIENT_SECRET=your_client_secret_here
INGRAM_CUSTOMER_NUMBER=your_customer_number_here
INGRAM_COUNTRY_CODE=US
INGRAM_SENDER_ID=YourCompanyName

# Set to "true" to use sandbox endpoint
INGRAM_USE_SANDBOX=true
